VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000
VITE_MOCK_AUTH=true
# Login/logout/me now call the real backend above; every other module
# (products, customers, sales, ...) still runs on the mock store via
# VITE_MOCK_AUTH. Set this back to true if the auth backend isn't running.
VITE_MOCK_LOGIN=false
